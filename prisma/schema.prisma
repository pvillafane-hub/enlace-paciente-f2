generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Session {
  id        String   @id @default(uuid())
  userId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  challenge String?
  challengeExpiresAt DateTime?

  user User? @relation(fields: [userId], references: [id])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(PATIENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  qrTokens PatientQRToken[]  // 🔥 relación QR

  // 🔥 INFO MÉDICA
  dateOfBirth DateTime?
  bloodType   String?
  allergies   String?
  contactPhone String?
  identityStatus String @default("CLEAR")

  // 🆕 LICENCIAS
  licenses License[]

  interopBindings InteropSandboxPatient[]
  documents           Document[]
  AuditLog            AuditLog[]
  AuthMethod          AuthMethod[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  accountActivities   AccountActivity[]
  guardianLinksAsGuardian GuardianLink[] @relation("GuardianLinksAsGuardian")
  guardianLinksAsPatient GuardianLink[] @relation("GuardianLinksAsPatient")
  identityReview IdentityReview? @relation("IdentityReviewUser")

  doctorPatients DoctorPatient[] @relation("DoctorPatients")
  patientDoctors DoctorPatient[] @relation("PatientDoctors")

  doctorRequests  MedicalAccessRequest[] @relation("DoctorRequests")
  patientRequests MedicalAccessRequest[] @relation("PatientRequests")

  doctorAlerts  MedicalAlert[] @relation("DoctorAlerts")
  patientAlerts MedicalAlert[] @relation("PatientAlerts")

  staffMembers ClinicStaff[] @relation("DoctorStaff")
  staffOf      ClinicStaff[] @relation("StaffUser")
  
  organizationMemberships OrganizationMember[]
  patientOrganizations PatientOrganization[]
  medicalGrantsAsPatient MedicalAccessGrant[] @relation("PatientGrants")
  medicalGrantsAsDoctor MedicalAccessGrant[] @relation("DoctorGrants")
  medicalGrantsAsGrantor MedicalAccessGrant[] @relation("GrantorGrants")
  accessAuditEvents AccessAuditEvent[] @relation("AccessActor")
  accessAuditPatients AccessAuditEvent[] @relation("AccessPatient")

  passwordChangedAt DateTime?

  
}

model AuthMethod {
  id           String    @id @default(uuid())
  userId       String
  type         String
  credentialId String    @unique
  publicKey    String
  counter      Int
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("auth_methods")
}

model Document {
  id        String    @id @default(uuid())
  userId    String
  filename  String
  filePath  String
  docType   String
  facility  String
  studyDate String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  bodyPart String?
  specialty String?
  proxyVisible Boolean @default(true)

  user   User        @relation(fields: [userId], references: [id])
  interopReceipt InteropSandboxReceipt?
  shares ShareLink[]
}

model ShareLink {
  id         String   @id @default(uuid())
  documentId String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DoctorPatient {
  id        String   @id @default(uuid())
  doctorId  String
  patientId String
  createdAt DateTime @default(now())

  doctor  User @relation("DoctorPatients", fields: [doctorId], references: [id])
  patient User @relation("PatientDoctors", fields: [patientId], references: [id])

  @@unique([doctorId, patientId])
}

model MedicalAccessRequest {
  id        String        @id @default(uuid())
  doctorId  String
  patientId String
  status    RequestStatus @default(PENDING)
  initiatedBy Role?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  doctor  User @relation("DoctorRequests", fields: [doctorId], references: [id])
  patient User @relation("PatientRequests", fields: [patientId], references: [id])

  @@unique([doctorId, patientId])
  @@index([patientId, status])
  @@index([doctorId, status])
}

model MedicalAlert {
  id         String   @id @default(uuid())
  doctorId   String
  patientId  String
  documentId String?
  type       String
  createdAt  DateTime @default(now())

  // 🔥 NUEVO (core feature)
  resolved   Boolean  @default(false)
  resolvedAt DateTime?

  doctor  User @relation("DoctorAlerts", fields: [doctorId], references: [id])
  patient User @relation("PatientAlerts", fields: [patientId], references: [id])
}

enum Role {
  ADMIN
  DOCTOR
  STAFF
  PATIENT
}

model License {
  id          String   @id @default(cuid())
  userId      String
  role        String   // PATIENT | DOCTOR
  status      String   // ACTIVE | INACTIVE | TRIAL
  plan        String?  // BASIC | PRO (para futuro)
  validUntil  DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PatientQRToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ClinicStaff {
  id        String   @id @default(cuid())

  doctorId String
  staffId  String

  role      String   @default("ASSISTANT")
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor User @relation("DoctorStaff", fields: [doctorId], references: [id])
  staff  User @relation("StaffUser", fields: [staffId], references: [id])

  @@unique([doctorId, staffId])
}
 
// MULTITENANT V1 - additive schema. No existing models or fields are removed.
// IMPORTANT: A membership never grants medical-record access by itself.
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  DOCTOR
  NURSE
  STAFF
}

enum MedicalGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MedicalGrantScope {
  READ_RECORD
  READ_AND_UPLOAD
  READ_UPLOAD_CATEGORIZE
}

model Organization {
  id        String @id @default(uuid())
  name      String
  slug      String @unique
  address   String?
  city      String?
  phone     String?
  email     String?
  contactName String?
  plan      String?
  activatedAt DateTime?
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
  patients PatientOrganization[]
  medicalGrants MedicalAccessGrant[]
  accessEvents AccessAuditEvent[]
}

model OrganizationMember {
  id             String @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, active])
  @@index([organizationId, role, active])
}

// Administrative association only. NOT a medical consent or access grant.
model PatientOrganization {
  id             String @id @default(uuid())
  organizationId String
  patientId      String
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      User @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([organizationId, patientId])
  @@index([patientId, active])
}

// Individual doctor authorization for a patient-owned longitudinal record.
// organizationId is the context of use, not the owner of the record.
// For cross-clinic access, the patient grants each doctor explicitly.
model MedicalAccessGrant {
  id             String @id @default(uuid())
  organizationId String
  patientId      String
  doctorId       String
  grantedById    String
  status         MedicalGrantStatus @default(ACTIVE)
  scope          MedicalGrantScope @default(READ_RECORD)
  validUntil     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  patient      User @relation("PatientGrants", fields: [patientId], references: [id], onDelete: Restrict)
  doctor       User @relation("DoctorGrants", fields: [doctorId], references: [id], onDelete: Restrict)
  grantedBy    User @relation("GrantorGrants", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@index([doctorId, organizationId, status])
  @@index([organizationId, patientId])
}

// Security audit for both allowed and denied access attempts.
model AccessAuditEvent {
  id             String @id @default(uuid())
  organizationId String?
  actorId        String
  patientId      String?
  action         String
  resourceType   String?
  resourceId     String?
  allowed        Boolean
  reason         String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User @relation("AccessActor", fields: [actorId], references: [id], onDelete: Restrict)
  patient      User? @relation("AccessPatient", fields: [patientId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([patientId, createdAt])
  @@index([actorId, createdAt])
}

// Existing Neon Fase 3 guardian relationships; CHECK constraints remain managed by SQL.
// ACTIVE requires verification, reviewedById, reviewedAt and validUntil.
model GuardianLink {
  id            String @id @default(uuid())
  guardianId    String
  patientId     String
  relationship  String
  status        String @default("PENDING")
  canUpload     Boolean @default(false)
  verification  String?
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  validUntil    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guardian    User @relation("GuardianLinksAsGuardian", fields: [guardianId], references: [id], onDelete: Restrict)
  patient     User @relation("GuardianLinksAsPatient", fields: [patientId], references: [id], onDelete: Restrict)

  @@unique([guardianId, patientId])
  @@index([guardianId, status, validUntil])
  @@index([status, createdAt])
}

model IdentityReview {
  id           String @id @default(uuid())
  userId       String @unique
  candidateIds String[]
  doctorId     String?
  status       String @default("PENDING")
  reason       String?
  reviewedById String?
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?

  user User @relation("IdentityReviewUser", fields: [userId], references: [id])

  @@index([status, createdAt])
}

// Synthetic integration receipts only. No relation to clinical User or Document.
model InteropSandboxReceipt {
  id          String   @id @default(uuid())
  source      String
  reportId    String
  fingerprint String
  format      String
  status      String
  normalized  Json
  deliveredDocumentId String? @unique
  deliveredAt DateTime?
  deliveryDocument Document? @relation(fields: [deliveredDocumentId], references: [id])
  createdAt   DateTime @default(now())
  events      InteropSandboxEvent[]
  @@unique([source, reportId])
}

model InteropSandboxPatient {
  id String @id @default(uuid())
  source String
  externalPatientId String
  userId String
  createdById String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@unique([source, externalPatientId])
}

model InteropSandboxEvent {
  id        String @id @default(uuid())
  receiptId String
  action    String
  actorId   String?
  reason    String?
  patientId String?
  createdAt DateTime @default(now())
  receipt   InteropSandboxReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  @@index([receiptId, createdAt])
}

// Administrative drafts only; these records never enable an external connection.
model InteropIntegrationDraft {
  id String @id @default(uuid())
  name String
  code String @unique
  protocol String
  direction String
  endpoint String?
  authType String
  credentialRef String?
  reviewAll Boolean @default(true)
  notes String?
  status String @default("DRAFT")
  version Int @default(1)
  createdById String
  updatedById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
}
