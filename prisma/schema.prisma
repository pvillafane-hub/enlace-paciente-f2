generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Session {
  id        String   @id @default(uuid())
  userId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  challenge String?
  challengeExpiresAt DateTime?

  user User? @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([expiresAt])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  contactPhone String?
  identityStatus String @default("CLEAR")
  identityReview IdentityReview?
  passwordHash String
  fullName     String
  role         Role     @default(PATIENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  guardianLinks GuardianLink[] @relation("GuardianLinks")
  interopBindings InteropSandboxPatient[]
  representatives GuardianLink[] @relation("Representatives")
  qrTokens PatientQRToken[]  // 🔥 relación QR

  // 🔥 INFO MÉDICA
  dateOfBirth DateTime?
  bloodType   String?
  allergies   String?

  // 🆕 LICENCIAS
  licenses License[]

  documents           Document[]
  AuditLog            AuditLog[]
  AuthMethod          AuthMethod[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  accountActivities   AccountActivity[]

  doctorPatients DoctorPatient[] @relation("DoctorPatients")
  patientDoctors DoctorPatient[] @relation("PatientDoctors")

  doctorRequests  MedicalAccessRequest[] @relation("DoctorRequests")
  patientRequests MedicalAccessRequest[] @relation("PatientRequests")

  doctorAlerts  MedicalAlert[] @relation("DoctorAlerts")
  patientAlerts MedicalAlert[] @relation("PatientAlerts")

  staffMembers ClinicStaff[] @relation("DoctorStaff")
  staffOf      ClinicStaff[] @relation("StaffUser")
  
  passwordChangedAt DateTime?

  
}

model AuthMethod {
  id           String    @id @default(uuid())
  userId       String
  type         String
  credentialId String    @unique
  publicKey    String
  counter      Int
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@map("auth_methods")
}

model Document {
  id        String    @id @default(uuid())
  userId    String
  filename  String
  filePath  String
  docType   String
  facility  String
  studyDate String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  proxyVisible Boolean @default(false)
  bodyPart String?
  specialty String?

  user   User        @relation(fields: [userId], references: [id])
  shares ShareLink[]
  interopReceipt InteropSandboxReceipt?
  @@index([userId, deletedAt, createdAt])
}

model ShareLink {
  id         String   @id @default(uuid())
  documentId String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([tokenHash])
  @@index([userId, expiresAt])
}

model AccountActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DoctorPatient {
  id        String   @id @default(uuid())
  doctorId  String
  patientId String
  createdAt DateTime @default(now())

  doctor  User @relation("DoctorPatients", fields: [doctorId], references: [id])
  patient User @relation("PatientDoctors", fields: [patientId], references: [id])

  @@unique([doctorId, patientId])
}

model MedicalAccessRequest {
  id        String        @id @default(uuid())
  doctorId  String
  patientId String
  status    RequestStatus @default(PENDING)
  initiatedBy Role?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  doctor  User @relation("DoctorRequests", fields: [doctorId], references: [id])
  patient User @relation("PatientRequests", fields: [patientId], references: [id])

  @@unique([doctorId, patientId])
  @@index([patientId, status])
  @@index([doctorId, status])
}

model MedicalAlert {
  id         String   @id @default(uuid())
  doctorId   String
  patientId  String
  documentId String?
  type       String
  createdAt  DateTime @default(now())

  // 🔥 NUEVO (core feature)
  resolved   Boolean  @default(false)
  resolvedAt DateTime?

  doctor  User @relation("DoctorAlerts", fields: [doctorId], references: [id])
  patient User @relation("PatientAlerts", fields: [patientId], references: [id])
  @@index([doctorId, resolved, createdAt])
}

enum Role {
  ADMIN
  DOCTOR
  STAFF
  PATIENT
}

model License {
  id          String   @id @default(cuid())
  userId      String
  role        String   // PATIENT | DOCTOR
  status      String   // ACTIVE | INACTIVE | TRIAL
  plan        String?  // BASIC | PRO (para futuro)
  validUntil  DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  @@index([userId, status, createdAt])
}

model PatientQRToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ClinicStaff {
  id        String   @id @default(cuid())

  doctorId String
  staffId  String

  role      String   @default("ASSISTANT")
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor User @relation("DoctorStaff", fields: [doctorId], references: [id])
  staff  User @relation("StaffUser", fields: [staffId], references: [id])

  @@unique([doctorId, staffId])
  @@index([staffId, active])
}
model SecurityRateLimit {
  id String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

model PaymentEvent {
  id String @id
  createdAt DateTime @default(now())
}

model GuardianLink {
  id String @id @default(cuid())
  guardianId String
  patientId String
  relationship String
  status String @default("PENDING")
  canUpload Boolean @default(false)
  verification String?
  requestedById String
  reviewedById String?
  reviewedAt DateTime?
  validUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guardian User @relation("GuardianLinks", fields: [guardianId], references: [id])
  patient User @relation("Representatives", fields: [patientId], references: [id])
  @@unique([guardianId, patientId])
  @@index([guardianId, status, validUntil])
  @@index([status, createdAt])
}

model IdentityReview {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  candidateIds String[]
  doctorId String?
  status String @default("PENDING")
  reason String?
  reviewedById String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  @@index([status, createdAt])
}

// Synthetic integration receipts only. No relation to clinical User or Document.
model InteropSandboxReceipt {
  id          String   @id @default(uuid())
  source      String
  reportId    String
  fingerprint String
  format      String
  status      String
  normalized  Json
  deliveredDocumentId String? @unique
  deliveredAt DateTime?
  deliveryDocument Document? @relation(fields: [deliveredDocumentId], references: [id])
  createdAt   DateTime @default(now())
  events      InteropSandboxEvent[]
  @@unique([source, reportId])
}

model InteropSandboxPatient {
  id String @id @default(uuid())
  source String
  externalPatientId String
  userId String
  createdById String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@unique([source, externalPatientId])
}

model InteropSandboxEvent {
  id        String @id @default(uuid())
  receiptId String
  action    String
  actorId   String?
  reason    String?
  patientId String?
  createdAt DateTime @default(now())
  receipt   InteropSandboxReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  @@index([receiptId, createdAt])
}
