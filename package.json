    "bcrypt": "^6.0.0",
    "browser-image-compression": "^2.0.2",
    "formidable": "^3.5.4",
    "html5-qrcode": "^2.3.8",
    "next": "^16.4.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^5.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^22.0.1",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie": "^0.6.0",
