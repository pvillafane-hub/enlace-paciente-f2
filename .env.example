# Use isolated test resources. Never copy production credentials here.
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/enlace_salud_test
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Connect a PRIVATE Blob store to the independent Vercel project (OIDC).
BLOB_STORE_ID=
# Optional for local development outside Vercel; never use a NEXT_PUBLIC prefix.
BLOB_READ_WRITE_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESET_EMAIL_FROM=
CRON_SECRET=

# New uploads: blob (default) or s3. Existing keys retain their provider.
DOCUMENT_STORAGE_PROVIDER=blob
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials.
AWS_SESSION_TOKEN=
